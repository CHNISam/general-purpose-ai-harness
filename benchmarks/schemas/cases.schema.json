{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "provenance_note": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "source_date",
          "source_fidelity",
          "prompt",
          "criteria"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R[0-9]{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "source_date": {
            "type": "string",
            "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
          },
          "source_fidelity": {
            "enum": [
              "verbatim",
              "near-verbatim",
              "reconstructed",
              "synthetic"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "description"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
